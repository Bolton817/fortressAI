datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String           @id @default(uuid())
  emailNormalised  String           @unique @map("email_normalised")
  passwordHash     String?          @map("password_hash")
  displayName      String           @map("display_name")
  phoneOptional    String?          @map("phone_optional")
  emailVerifiedAt  DateTime?        @map("email_verified_at")
  status           String           @default("unverified") // unverified, active, suspended, deleted
  timezone         String           @default("UTC")
  termsAcceptedAt  DateTime?        @map("terms_accepted_at")
  policyVersion    String?          @map("policy_version")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  memberships      SiteMembership[]
  accounts         Account[]
  sessions         Session[]
  notifications    Notification[]
  auditEvents      AuditEvent[]
  domainOrders     DomainOrder[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String   // e.g. "google"
  providerAccountId String   @map("provider_account_id")
  scope             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  identifier String    // email address or user ID
  tokenType  String    @map("token_type") // "email_verify", "password_reset"
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([identifier, tokenType])
  @@map("verification_tokens")
}

model Site {
  id                    String           @id @default(uuid())
  ownerUserId           String           @map("owner_user_id")
  name                  String
  platformSlug          String           @unique @map("platform_slug")
  lifecycleStatus       String           @default("draft") @map("lifecycle_status")
  currentDraftRevisionId String?         @map("current_draft_revision_id")
  publishedReleaseId    String?          @map("published_release_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  memberships           SiteMembership[]
  businessProfile       BusinessProfile?
  revisions             SiteRevision[]
  pages                 Page[]
  assetBindings         AssetBinding[]
  notifications         Notification[]
  releases              Release[]
  domains               DomainMapping[]
  domainOrders          DomainOrder[]

  @@index([ownerUserId])
  @@map("sites")
}

model SiteMembership {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  userId    String   @map("user_id")
  role      String   @default("owner") // "owner", "admin", "member"
  createdAt DateTime @default(now()) @map("created_at")

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([userId])
  @@map("site_memberships")
}

model BusinessProfile {
  id              String   @id @default(uuid())
  siteId          String   @unique @map("site_id")
  factsJson       Json     @map("facts_json")
  sourceMapJson   Json?    @map("source_map_json")
  locale          String   @default("en")
  marketContext   String?  @map("market_context")
  lastConfirmedAt DateTime? @map("last_confirmed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model SiteRevision {
  id          String   @id @default(uuid())
  siteId      String   @map("site_id")
  version     Int
  configJson  Json     @map("config_json")
  createdBy   String   @map("created_by")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, version])
  @@index([siteId])
  @@map("site_revisions")
}

model Page {
  id                      String                @id @default(uuid())
  siteId                  String                @map("site_id")
  slug                    String
  pageType                String                @map("page_type")
  title                   String
  sortOrder               Int                   @default(0) @map("sort_order")
  currentContentRevisionId String?              @map("current_content_revision_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  site                    Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentRevisions        PageContentRevision[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("pages")
}

model PageContentRevision {
  id            String   @id @default(uuid())
  pageId        String   @map("page_id")
  revision      Int
  contentJson   Json     @map("content_json")
  schemaVersion String   @map("schema_version")
  sourceJobId   String?  @map("source_job_id")
  createdAt     DateTime @default(now()) @map("created_at")

  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, revision])
  @@index([pageId])
  @@map("page_content_revisions")
}

model Asset {
  id                 String         @id @default(uuid())
  cloudinaryPublicId String         @unique @map("cloudinary_public_id")
  status             String         @default("approved") // draft, review, approved, expired
  sourceProvider     String?        @map("source_provider")
  licenceType        String         @default("approved-curated") @map("licence_type")
  licenceExpiryAt    DateTime?      @map("licence_expiry_at")
  attributionText    String?        @map("attribution_text")
  aspectRatio        String         @map("aspect_ratio")
  width              Int?
  height             Int?
  altTextDefault     String         @map("alt_text_default")
  tagsJson           Json           @map("tags_json")
  createdAt          DateTime       @default(now()) @map("created_at")

  bindings           AssetBinding[]

  @@map("assets")
}

model AssetBinding {
  id                String   @id @default(uuid())
  siteId            String   @map("site_id")
  sectionInstanceId String   @map("section_instance_id")
  slotId            String   @map("slot_id")
  assetId           String   @map("asset_id")
  role              String   @default("content")
  selectedAt        DateTime @default(now()) @map("selected_at")

  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@index([assetId])
  @@map("asset_bindings")
}

model Notification {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  siteId         String?   @map("site_id")
  idempotencyKey String?   @unique @map("idempotency_key")
  type           String    // BUILD_SUCCEEDED, BUILD_FAILED, SECURITY_ALERT, SYSTEM_UPDATE
  title          String
  body           String
  targetRoute    String?   @map("target_route")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  site           Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  action       String   // user.login, user.register, user.password_reset, site.create, site.delete, etc.
  targetType   String   @map("target_type") // user, site, session
  targetId     String   @map("target_id")
  metadataJson Json?    @map("metadata_json")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("audit_events")
}

model Release {
  id                  String   @id @default(uuid())
  siteId              String   @map("site_id")
  releaseNumber       Int      @map("release_number")
  configJson          Json     @map("config_json")
  commitMessage       String?  @map("commit_message")
  publishedByUserId   String   @map("published_by_user_id")
  healthStatus        String   @default("healthy") @map("health_status") // healthy, rolled_back, degraded
  buildDurationMs     Int?     @map("build_duration_ms")
  artefactHash        String?  @map("artefact_hash")
  seoMetadataSnapshot Json?    @map("seo_metadata_snapshot")
  sitemapXml          String?  @map("sitemap_xml")
  robotsTxt           String?  @map("robots_txt")
  createdAt           DateTime @default(now()) @map("created_at")

  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, releaseNumber])
  @@index([siteId])
  @@map("releases")
}

model DomainMapping {
  id                 String    @id @default(uuid())
  siteId             String    @map("site_id")
  hostname           String    @unique
  domainType         String    @default("platform_subdomain") @map("domain_type") // platform_subdomain, custom_apex, custom_subdomain
  verificationToken  String?   @map("verification_token")
  verificationStatus String    @default("pending") @map("verification_status") // pending, verified, failed
  sslStatus          String    @default("pending") @map("ssl_status") // pending, active, error
  isPrimary          Boolean   @default(false) @map("is_primary")
  challengeType      String?   @default("txt") @map("challenge_type") // txt, cname
  challengeHost      String?   @map("challenge_host")
  challengeValue     String?   @map("challenge_value")
  challengeExpiresAt DateTime? @map("challenge_expires_at")
  lastDnsCheckAt     DateTime? @map("last_dns_check_at")
  lastTlsCheckAt     DateTime? @map("last_tls_check_at")
  dnsInstructions    Json?     @map("dns_instructions")
  eppAuthCode        String?   @map("epp_auth_code")
  isLocked           Boolean   @default(true) @map("is_locked")
  verifiedAt         DateTime? @map("verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("domain_mappings")
}

model DomainOrder {
  id                  String    @id @default(uuid())
  siteId              String    @map("site_id")
  userId              String    @map("user_id")
  domainName          String    @map("domain_name")
  tld                 String
  termYears           Int       @default(1) @map("term_years")
  priceCents          Int       @map("price_cents")
  currency            String    @default("USD")
  renewalPriceCents   Int       @map("renewal_price_cents")
  idempotencyKey      String    @unique @map("idempotency_key")
  orderStatus         String    @default("pending") @map("order_status") // pending, completed, failed, refunded
  providerOrderId     String?   @map("provider_order_id")
  registrantJson      Json      @map("registrant_json")
  receiptJson         Json?     @map("receipt_json")
  expiresAt           DateTime? @map("expires_at")
  autoRenew           Boolean   @default(true) @map("auto_renew")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([userId])
  @@map("domain_orders")
}
