# =============================================================================
# FORTRESS AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env.local' to configure live external integrations.
# If keys are omitted or set to mock defaults, Fortress AI automatically runs
# in Zero-Friction Dev/Mock Mode with simulated adapters and deterministic tests.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# Public base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application session and signed export token secret (generate with: openssl rand -hex 32)
SESSION_SECRET="fortress-dev-session-secret-change-in-production-32bytes"

# PostgreSQL connection string (Supabase Connection Pooler / Transaction mode)
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fortress_dev?schema=public"

# Supabase API credentials (optional if using direct PostgreSQL)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 2. AI MODEL GENERATION (Google Gemini API)
# -----------------------------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
# When left empty, Fortress AI uses deterministic archetype generators.
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-2.5-flash"

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Google Cloud Console)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# When left as mock-*, 1-click mock login is enabled for instant local testing.
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# -----------------------------------------------------------------------------
# 4. CLOUDINARY CURATED ASSETS & MEDIA CDN
# -----------------------------------------------------------------------------
# Cloudinary Dashboard -> Settings -> Access Keys: https://cloudinary.com/console
# Curated public assets are served via Cloudinary's global media delivery network.
CLOUDINARY_CLOUD_NAME="megascript"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Brevo / Sendinblue)
# -----------------------------------------------------------------------------
# Brevo Dashboard -> SMTP & API -> API Keys: https://app.brevo.com/settings/keys/api
# When left with dummy key, outgoing emails are recorded in in-memory logs.
BREVO_API_KEY="xkeysib-test-dummy-key"
BREVO_SENDER_EMAIL="noreply@fortress-ai.com"
BREVO_SENDER_NAME="Fortress AI Notifications"

# -----------------------------------------------------------------------------
# 6. PAYMENTS & SUBSCRIPTIONS (IntaSend / Stripe)
# -----------------------------------------------------------------------------
# IntaSend Developer Keys: https://payment.intasend.com/settings/api-keys/
# When left with dummy keys, payments use the deterministic mock sandbox.
INTASEND_PUBLISHABLE_KEY="ISPubKey_test_dummy"
INTASEND_API_SECRET="ISSecretKey_test_dummy"
INTASEND_WEBHOOK_SECRET="intasend_test_secret_123"

# -----------------------------------------------------------------------------
# 7. DOMAIN REGISTRAR (KeNIC / EPP Provider)
# -----------------------------------------------------------------------------
# Primary adapter: mock-kenic-epp (supports .ke, .co.ke, .com, .org, .net)
REGISTRAR_ADAPTER="mock-kenic-epp"
# REGISTRAR_EPP_SERVER="epp.kenic.or.ke"
# REGISTRAR_EPP_USERNAME=""
# REGISTRAR_EPP_PASSWORD=""
